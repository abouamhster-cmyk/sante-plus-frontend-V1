# ============================================================
# SANTÉ PLUS — FRONTEND : VARIABLES D'ENVIRONNEMENT
# ============================================================
# Copiez ce fichier en `.env.local` pour le développement :
#   cp .env.example .env.local
#
# ⚠️ RÈGLE ABSOLUE : tout ce qui commence par VITE_ est intégré au bundle
# JavaScript envoyé au navigateur. C'est donc PUBLIC et lisible par n'importe
# quel visiteur (F12 → Sources).
#
# N'y mettez JAMAIS :
#   ❌ SUPABASE_SERVICE_ROLE_KEY   ❌ FEDAPAY_SECRET_KEY
#   ❌ VAPID_PRIVATE_KEY           ❌ la moindre clé privée
# Ces secrets restent exclusivement côté backend.
# ============================================================

# --- API BACKEND --------------------------------------------
# ⚠️ Doit se terminer par /api
VITE_API_URL=https://sante-plus-backend-v1.onrender.com/api

# --- SUPABASE -----------------------------------------------
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé ANON (publique). Elle est sûre à exposer À CONDITION que le RLS
# (Row Level Security) soit activé sur TOUTES vos tables.
# 🚨 Vérifiez-le : Supabase → Table Editor → chaque table → "RLS enabled".
VITE_SUPABASE_ANON_KEY=

# --- FIREBASE (NOTIFICATIONS PUSH) --------------------------
# Publiques par nature. Ce qui protège vos données, ce sont les
# Security Rules Firebase et la restriction de la clé par domaine.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Clé VAPID PUBLIQUE uniquement (jamais la privée).
VITE_VAPID_PUBLIC_KEY=

# --- APPLICATION --------------------------------------------
VITE_APP_NAME=Santé Plus Services
